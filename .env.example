# Base Postgres (locale ou Supabase)
# Schéma Postgres (DB_SCHEMA=presence sur Supabase). Laisser vide en local.
DB_SCHEMA=
DATABASE_URL=postgres://presence:presence@localhost:5432/presence

# Clé Gemini pour l'analyse vidéo et le coach IA — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# v1 sans authentification : identifiant du membre "connecté" (1 = Hélène dans le seed)
CURRENT_MEMBER_ID=1

# Liens de réservation Calendly (tableau de bord)
CALENDLY_URL=
CALENDLY_EXPLO_URL=

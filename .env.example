# Base Postgres (locale ou Supabase)
# Schéma Postgres (DB_SCHEMA=presence sur Supabase). Laisser vide en local.
DB_SCHEMA=
DATABASE_URL=postgres://presence:presence@localhost:5432/presence

# Clé Gemini pour l'analyse vidéo et le coach IA — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Adresse publique de l'application (liens d'invitation)
APP_URL=http://localhost:3000
# Page affichée aux personnes dont l'accès est terminé, pour revenir dans le cercle
MEMBERSHIP_URL=

# Supabase : connexion des membres (Auth), invitations et stockage des vidéos.
# La clé de service reste côté serveur ; la clé anon est lue par le navigateur.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Liens de réservation Calendly (tableau de bord)
CALENDLY_URL=
CALENDLY_EXPLO_URL=

# Lien de téléchargement de l’application Miracle Routine (bloc « Mes rituels » du tableau de bord)
VITE_MIRACLE_ROUTINE_URL=
